<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bg-grad-4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#180c2e" />
      <stop offset="50%" stop-color="#241442" />
      <stop offset="100%" stop-color="#0f071d" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#bg-grad-4)" />

  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="90" x2="800" y2="90" />
    <line x1="0" y1="180" x2="800" y2="180" />
    <line x1="0" y1="270" x2="800" y2="270" />
    <line x1="0" y1="360" x2="800" y2="360" />
    <line x1="200" y1="0" x2="200" y2="450" />
    <line x1="400" y1="0" x2="400" y2="450" />
    <line x1="600" y1="0" x2="600" y2="450" />
  </g>

  <!-- Container -->
  <rect x="100" y="60" width="600" height="330" rx="16" fill="#140f24" stroke="#a855f7" stroke-width="2" stroke-opacity="0.4" />

  <!-- Top Bar -->
  <rect x="100" y="60" width="600" height="42" rx="16" fill="#24183d" />
  <circle cx="130" cy="81" r="5" fill="#ef4444" />
  <circle cx="148" cy="81" r="5" fill="#f59e0b" />
  <circle cx="166" cy="81" r="5" fill="#10b981" />
  <text x="190" y="86" fill="#c084fc" font-family="monospace" font-size="12">AEGIS Topology · Cisco PAgP EtherChannel &amp; Docker BIND 9</text>

  <!-- Left: Packet Tracer Architecture -->
  <g transform="translate(130, 120)">
    <rect x="0" y="0" width="250" height="150" rx="10" fill="#0d0817" stroke="#7e22ce" stroke-width="1" />
    <text x="15" y="24" fill="#d8b4fe" font-family="sans-serif" font-weight="bold" font-size="12">PACKET TRACER TOPOLOGY</text>
    
    <!-- Switch SW1 & SW2 with PAgP bundle -->
    <rect x="20" y="45" width="80" height="35" rx="6" fill="#1e1338" stroke="#a855f7" stroke-width="1" />
    <text x="35" y="66" fill="#ffffff" font-family="monospace" font-size="11">SW-01</text>

    <rect x="150" y="45" width="80" height="35" rx="6" fill="#1e1338" stroke="#a855f7" stroke-width="1" />
    <text x="165" y="66" fill="#ffffff" font-family="monospace" font-size="11">SW-02</text>

    <!-- Double Link PAgP -->
    <line x1="100" y1="56" x2="150" y2="56" stroke="#38bdf8" stroke-width="2" />
    <line x1="100" y1="68" x2="150" y2="68" stroke="#38bdf8" stroke-width="2" />
    <ellipse cx="125" cy="62" rx="12" ry="18" fill="none" stroke="#eab308" stroke-width="1.5" stroke-dasharray="3" />
    
    <text x="20" y="105" fill="#a855f7" font-family="monospace" font-size="10">PAgP Port-Channel 1</text>
    <text x="20" y="125" fill="#94a3b8" font-family="monospace" font-size="9">VLAN 10 Prod / VLAN 20 Admin</text>
  </g>

  <!-- Right: Docker BIND 9 -->
  <g transform="translate(420, 120)">
    <rect x="0" y="0" width="250" height="150" rx="10" fill="#0d0817" stroke="#0284c7" stroke-width="1" />
    <text x="15" y="24" fill="#38bdf8" font-family="sans-serif" font-weight="bold" font-size="12">DOCKER BIND 9 DNS</text>
    
    <!-- Docker Container Box -->
    <rect x="20" y="42" width="210" height="92" rx="6" fill="#1e1338" stroke="#0369a1" stroke-width="1" />
    <text x="30" y="62" fill="#38bdf8" font-family="monospace" font-size="10">container: aegis-dns-bind9</text>
    <text x="30" y="78" fill="#a855f7" font-family="monospace" font-size="9">Host: AlmaLinux 9 (KVM)</text>
    <text x="30" y="94" fill="#22c55e" font-family="monospace" font-size="9">Zone: aegis.internal IN A</text>
    <text x="30" y="112" fill="#e2e8f0" font-family="monospace" font-size="9">Status: Up 24 days (Port 53/UDP)</text>
  </g>

  <!-- Bottom: Terminal verification -->
  <g transform="translate(130, 290)">
    <rect x="0" y="0" width="540" height="85" rx="8" fill="#090511" stroke="#24183d" stroke-width="1" />
    <text x="15" y="24" fill="#34d399" font-family="monospace" font-size="11">student@almalinux:~$ dig @10.0.10.53 ns1.aegis.internal +short</text>
    <text x="15" y="44" fill="#facc15" font-family="monospace" font-size="11">;; ANSWER SECTION: 10.0.10.53 (QUERY TIME: 1 msec)</text>
    <text x="15" y="68" fill="#c084fc" font-family="monospace" font-size="11">Compétences : D1 Patrimoine, D4 Projet &amp; D5 Service IT</text>
  </g>

  <text x="400" y="420" text-anchor="middle" fill="#94a3b8" font-family="sans-serif" font-size="12">Déposez votre capture dans /public/e5/4-aegis/preview.png</text>
</svg>
